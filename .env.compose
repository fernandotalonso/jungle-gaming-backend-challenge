# API
APP_PORT=3000
APP_ENV=local

# PostgreSQL
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle_wagering
POSTGRES_PORT=5432
DATABASE_URL=postgres://jungle:jungle@postgres:5432/jungle_wagering

# SQS (LocalStack)
SQS_REGION=us-east-1
SQS_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo

# SQS consumer
CONSUMER_ENABLED=true

# outbox publisher
PUBLISHER_ENABLED=true

# database pool (bun test shares one pool across all suite files)
PG_POOL_MAX=40

# pending-reference worker (README 7.1)
REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_INTERVAL_MS=5000

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
# issuer Fixo (o mesmo valor vai nos tokens mintados do host e da rede)
# KEYCLOAK_JWKS_URL = backchannel dentro da rede do compose
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/jungle/protocol/openid-connect/certs
KEYCLOAK_REALM=jungle
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_API_AUDIENCE=wagering-api
