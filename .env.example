# API
APP_PORT=3000
APP_ENV=local

# PostgreSQL
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle_wagering
POSTGRES_PORT=5432
DATABASE_URL=postgres://jungle:jungle@localhost:5432/jungle_wagering

# SQS (LocalStack)
SQS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=jungle
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_API_AUDIENCE=wagering-api
